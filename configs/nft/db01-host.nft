#!/usr/sbin/nft -f
# DB01 host firewall (defense in depth): MariaDB only for the app servers and the DMZ web servers.
# Users (VLAN 50) and everything else are refused, even if the network lets them through.
flush ruleset
table inet host {
    chain input {
        type filter hook input priority filter; policy accept;
        tcp dport 3306 ip saddr { 127.0.0.1, 10.10.20.0/24, 10.10.60.0/24 } accept
        tcp dport 3306 counter drop comment "MariaDB refused"
    }
}
