#!/usr/sbin/nft -f
# EDGE-R2: NAT toward ISP-B + publishes the public website (DMZ virtual IP 10.10.60.20 = www.dc.lab) on 80/443
flush ruleset

table ip nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        # Port-forward: public IP of this edge, TCP 80/443 -> DMZ load balancer virtual IP
        iifname "eth1" tcp dport { 80, 443 } counter dnat to 10.10.60.20
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        # Everything leaving to the ISP is hidden behind this edge's WAN IP
        oifname "eth1" masquerade
        # Port-forwarded traffic is also source-NATed so the reply comes back
        # through THIS edge (otherwise it would leave via the other ISP).
        oifname { "eth2", "eth3" } ct status dnat masquerade
    }
}

table inet edge {
    # attackers detected by Suricata (scripts/ids.sh) - dropped before the port-forward, for 10 minutes
    set blocklist {
        type ipv4_addr
        flags timeout
    }
    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        iifname "eth1" ip saddr @blocklist counter drop comment "blocked by the IPS"
    }
    chain input {
        type filter hook input priority filter; policy accept;
        iifname "eth1" ct state established,related accept
        iifname "eth1" ip protocol icmp accept
        iifname "eth1" counter drop comment "nothing on the router itself is exposed to the ISP"
    }
}
