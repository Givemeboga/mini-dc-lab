# Generated by containerlab at every deploy (node dirs, certificates, ansible inventory)
clab-mini-dc/
.clab-mini-dc.clab.yml.bak

# Secrets generated per machine by scripts/gen-secrets.sh (template: lab.env.example)
lab.env
pki/

# Logs
deploy.log
.deploy-run.out

# Backups of the TopoViewer layout
*.bak
*.bak[0-9]*

# TrueNAS VM: ISO and virtual disks (several GB, per machine)
truenas/

# Arista cEOS image: licensed, every member downloads their own
*.tar.xz
*.tar

# Local tool settings
.claude/settings.local.json
.vscode/

# Python bytecode
__pycache__/
